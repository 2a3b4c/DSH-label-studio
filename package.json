{
  "name": "dsh-label-studio-workbench",
  "description": "Label Studio plugin: managed local server, PAT-authenticated REST tools, and a docked browser workbench",
  "version": "0.2.0-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2a3b4c/DSH-label-studio.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./packages/client-ui/lib/types/client/index.d.ts",
      "default": "./packages/client-ui/lib/client.js"
    },
    "./protocol": {
      "types": "./packages/protocol/lib/types/index.d.ts",
      "default": "./packages/protocol/lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "configure-pat.mjs",
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "INSTALL.zh.md",
    "packages/client-ui/lib/client.js",
    "packages/client-ui/lib/types/**/*.d.ts",
    "packages/protocol/lib/index.js",
    "packages/protocol/lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-label-studio-protocol": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.3",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.3",
    "react": "^18.2.0"
  },
  "scripts": {
    "configure-pat": "node configure-pat.mjs",
    "typecheck": "tsc -p packages/protocol/tsconfig.json && tsc -p tsconfig.json && tsc -p packages/client-ui/tsconfig.json",
    "bundle": "tsdown && pnpm --dir packages/protocol run bundle && pnpm --dir packages/client-ui run bundle",
    "build": "pnpm run typecheck && pnpm run bundle",
    "test:source": "vitest run --exclude '**/*.test.mjs' tests packages",
    "test:docs": "vitest run tests/docs.spec.ts",
    "test:artifact": "node --test tests/*.test.mjs",
    "test:nodenext-consumer": "tsc -p tsconfig.nodenext-consumer.json",
    "test": "pnpm run build && pnpm run test:source && pnpm run test:artifact && pnpm run test:nodenext-consumer"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-test-runtime": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.32.0",
    "jsdom": "^27.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
